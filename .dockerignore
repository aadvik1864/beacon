# Allow-list context: git history, reports, .env, and secrets never enter builds.
**
!pyproject.toml
!requirements.lock
!src/
src/**
!src/beacon/
src/beacon/**
!src/beacon/*.py
!frontend/
frontend/**
!frontend/package.json
!frontend/package-lock.json
!frontend/THIRD_PARTY_NOTICES.md
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/index.html
!frontend/public/
frontend/public/**
!frontend/public/favicon.svg
!frontend/public/theme.js
!frontend/src/
frontend/src/**
!frontend/src/*.ts
!frontend/src/*.tsx
!frontend/src/*.css
!frontend/src/hooks/
frontend/src/hooks/*
!frontend/src/hooks/*.ts
!frontend/src/lib/
frontend/src/lib/*
!frontend/src/lib/*.ts
!frontend/src/test/
frontend/src/test/*
!frontend/src/test/*.ts
!frontend/src/components/
frontend/src/components/*
!frontend/src/components/*.tsx
!frontend/src/components/experiment/
frontend/src/components/experiment/*
!frontend/src/components/experiment/*.tsx
!frontend/src/components/react-bits/
frontend/src/components/react-bits/*
!frontend/src/components/react-bits/*.tsx
!deploy/
deploy/**
!deploy/Dockerfile.*
!deploy/nginx.conf.template
!deploy/gateway-entrypoint.sh
# Directory re-inclusion can re-include descendants with the legacy builder.
frontend/node_modules/
frontend/dist/
frontend/e2e/
frontend/test-results/
frontend/playwright-report/
frontend/coverage/
src/*.egg-info/
**/__pycache__/
**/.env*
**/secrets/
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite*
