FROM golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS build
ENV GOTOOLCHAIN=local GOFLAGS=-p=2 CGO_ENABLED=0
RUN apk add --no-cache git
WORKDIR /build
# Pin the upstream security release; rebuild with patched Go and JOSE libraries.
RUN git init && git remote add origin https://github.com/oauth2-proxy/oauth2-proxy.git && git fetch --depth 1 origin ea755ac07aa200acc22e02f95d25b91de6c9fe20 && git checkout --detach FETCH_HEAD
RUN go get golang.org/x/net@v0.62.0 github.com/go-jose/go-jose/v4@v4.1.9 && go mod tidy && go mod verify
# Keep release identification accurate after applying the dependency security patch.
RUN git update-ref refs/tags/v7.15.6 ea755ac07aa200acc22e02f95d25b91de6c9fe20 && go build -trimpath -ldflags='-s -w' -o /out/oauth2-proxy .

FROM quay.io/oauth2-proxy/oauth2-proxy:v7.15.6@sha256:c3415e8660af553f5e18f5d90db050614c02493c0ac6260ac59442f6d9b12048
COPY --from=build /out/oauth2-proxy /bin/oauth2-proxy
USER 10001:10001
