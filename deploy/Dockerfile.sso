FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS build
ENV GOTOOLCHAIN=local GOFLAGS=-p=2 CGO_ENABLED=0
RUN apk add --no-cache git
WORKDIR /build
# Upstream 7.15.5 fixes the 7.15.0 auth advisories. Rebuild for current Go/x/net fixes.
RUN git init && git remote add origin https://github.com/oauth2-proxy/oauth2-proxy.git && git fetch --depth 1 origin 6e4bd00eea928c0268871954000f1f4fa8c91d30 && git checkout --detach FETCH_HEAD
RUN go get golang.org/x/net@v0.60.0 && go mod verify && go build -trimpath -ldflags='-s -w' -o /out/oauth2-proxy .
# Keep release identification accurate after applying the dependency security patch.
RUN git update-ref refs/tags/v7.15.5 6e4bd00eea928c0268871954000f1f4fa8c91d30 && go build -trimpath -ldflags='-s -w' -o /out/oauth2-proxy .

FROM quay.io/oauth2-proxy/oauth2-proxy:v7.15.5@sha256:8498b0d0ef0a7b29686414000a08aee467f02d0299c9ed1e006a8f33fc017916
COPY --from=build /out/oauth2-proxy /bin/oauth2-proxy
USER 10001:10001
