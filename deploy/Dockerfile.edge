FROM golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS build
ENV GOTOOLCHAIN=local GOFLAGS=-p=2 CGO_ENABLED=0
RUN apk add --no-cache git
WORKDIR /build
# Pinned Caddy release commit, rebuilt with patched Go and x/net.
RUN git init && git remote add origin https://github.com/caddyserver/caddy.git && git fetch --depth 1 origin 0d98caea58f794f88e709b1bef2880996a471bca && git checkout --detach FETCH_HEAD
# Pin Smallstep's upstream JOSE-v4 migration, which is not yet tagged.
# It adapts certificates to crypto 0.92 and removes the unsupported JOSE-v3 dependency.
RUN go get github.com/smallstep/certificates@cddde30af36e238f156bb557bfd1f11a05ffe6f9 golang.org/x/net@v0.62.0 go.step.sm/crypto@v0.92.1 github.com/go-jose/go-jose/v4@v4.1.9 && go mod tidy && go mod verify
# Preserve the exact verified annotated release tag in Go's VCS build metadata.
# Without it, Go invents a v2.0.0 pseudo-version and scanners misidentify this release.
RUN git update-ref refs/tags/v2.11.9 0d98caea58f794f88e709b1bef2880996a471bca && go build -trimpath -ldflags='-s -w' -o /out/caddy ./cmd/caddy

FROM caddy:2-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
# Upstream grants a file capability for low ports. We use high container ports;
# remove it so execution also works with cap_drop=ALL/no-new-privileges.
RUN apk --no-cache upgrade && setcap -r /usr/bin/caddy
COPY --from=build /out/caddy /usr/bin/caddy
USER 10001:10001
