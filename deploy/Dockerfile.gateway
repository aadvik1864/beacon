FROM node:26-alpine@sha256:143494b1da2945f061539253adc65e4f1569ddf07da2d384c022c791a9d90a4a AS build
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:mainline-alpine@sha256:b5047b9b76845eac124358373c6852377c52e4b05834a47647e955dd91cb8f1e
USER root
RUN apk --no-cache upgrade
COPY --from=build /build/dist /usr/share/nginx/html
COPY deploy/nginx.conf.template /etc/beacon/nginx.conf.template
COPY deploy/gateway-entrypoint.sh /etc/beacon/entrypoint.sh
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/bin/sh", "/etc/beacon/entrypoint.sh"]
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
