FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:stable-alpine@sha256:15c994d10d6d78658721c3bcafff14cb281fba2a4bdf9d5ba92c416a472516e3
USER root
RUN apk upgrade --no-cache
COPY --from=build /build/dist /usr/share/nginx/html
COPY --from=build /build/node_modules/@fontsource/ibm-plex-sans/LICENSE /usr/share/nginx/html/licenses/IBM-Plex-Sans.txt
COPY --from=build /build/node_modules/@fontsource/ibm-plex-mono/LICENSE /usr/share/nginx/html/licenses/IBM-Plex-Mono.txt
COPY frontend/THIRD_PARTY_NOTICES.md /usr/share/nginx/html/licenses/React-Bits.txt
COPY deploy/nginx.conf.template /etc/beacon/nginx.conf.template
COPY deploy/gateway-entrypoint.sh /etc/beacon/entrypoint.sh
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/bin/sh", "/etc/beacon/entrypoint.sh"]
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
